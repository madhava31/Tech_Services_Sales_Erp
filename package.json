{
  "name": "technicon-sales-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Technicon Sales ERP: mobile-first field sales CRM for Technicon Services. Separate application with its own database; reads the Technicon Services ERP read-only over its API.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev:api": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build && node -e \"import('node:fs').then(fs => fs.cpSync('web/dist', 'dist', { recursive: true }))\"",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "typecheck": "npm --prefix web run typecheck",
    "db:migrate": "node server/db/migrate.js latest",
    "db:migrate:status": "node server/db/migrate.js status",
    "db:migrate:test": "node server/db/migrate.js latest --test",
    "user:set-password": "node server/scripts/set-password.js",
    "seed:demo": "node server/scripts/seed-demo.js",
    "demo:delete": "node server/scripts/delete-demo.js",
    "products:import": "node server/scripts/import-products.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "4.4.0",
    "express": "^4.19.2",
    "nodemailer": "10.3.1",
    "pg": "^8.13.1",
    "web-push": "3.6.7"
  }
}
