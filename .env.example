# Copy to .env (git-ignored). Server-side only — nothing here reaches the browser.

# This application's OWN PostgreSQL database. Never the Technicon Services ERP database.
# Local development: a local Postgres database. Production: a dedicated Supabase project.
DATABASE_URL=postgres://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/technicon_sales_erp_dev

# Supabase: the app connects through the pooler. On serverless hosting (Vercel) use the
# transaction pooler, port 6543, and keep DATABASE_POOL_MAX at 1-3, because Supabase caps the total
# connections across every running copy of the app. Migrations need the session pooler (port 5432)
# or the direct connection, as they hold a lock for the whole run.
# Remote databases need DATABASE_SSL_CA_FILE: the CA certificate from Supabase (Project Settings →
# Database), saved as a file next to the app.
# DATABASE_POOL_MAX=10
# DATABASE_SSL_CA_FILE=

# Comma-separated origins allowed to call the API with credentials. Leave empty when the web app
# and API are served from the same origin (the default deployment).
CLIENT_ORIGIN=

PORT=4100

# Technicon Services ERP, read-only. See docs/erp-integration/README.md. Left empty, quotations are
# entered by hand. ERP_API_KEY is a secret, and must match ERP_INTEGRATION_KEY on the ERP.
ERP_API_URL=
ERP_API_KEY=

# Phone push reminders. Generate a pair once per environment with: npx web-push generate-vapid-keys
# Left empty, reminders still appear inside the app. The private key is a secret: never commit it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Email for the weekly report. Left empty, the report stays in the app. SMTP_PASS is a secret.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# This app's public address, for the link in the email.
APP_URL=
